        "device": {
          "type": "subckt",
          "text": "* HC595: 8-bit shift register (SRCLK, cleared by SRCLR low) into a storage register\n* (RCLK); QA…QH drive while OE is low, QH' (qhs) is the shift register's last stage.\n* XSPICE digital: inputs switch at VCC/2, outputs follow VCC through 50 ohm, typical\n* 5 V delays. Supply current isn't modelled.\n.subckt HC595 ser srclk srclr rclk oe qa qb qc qd qe qf qg qh qhs vcc gnd\nCser ser gnd 3.5p\nBser n_ser 0 V = v(ser,gnd)/max(v(vcc,gnd),1)\nAser [n_ser] [d_ser] hc_in\nCsrclk srclk gnd 3.5p\nBsrclk n_srclk 0 V = v(srclk,gnd)/max(v(vcc,gnd),1)\nAsrclk [n_srclk] [d_srclk] hc_in\nCsrclr srclr gnd 3.5p\nBsrclr n_srclr 0 V = v(srclr,gnd)/max(v(vcc,gnd),1)\nAsrclr [n_srclr] [d_srclr] hc_in\nCrclk rclk gnd 3.5p\nBrclk n_rclk 0 V = v(rclk,gnd)/max(v(vcc,gnd),1)\nArclk [n_rclk] [d_rclk] hc_in\nCoe oe gnd 3.5p\nBoe n_oe 0 V = v(oe,gnd)/max(v(vcc,gnd),1)\nAoe [n_oe] [d_oe] hc_in\nAU2 d_srclr x1 hc_not\nAU4 d_oe x3 hc_not\nAen [x3] [m_en] hc_fb\nAU5 d_ser d_srclk NULL x1 sr0 nsr0 hc_dff\nAU6 sr0 d_rclk NULL NULL st0 nst0 hc_dff\nAqa [st0] [m_qa] hc_out\nBqa o_qa gnd V = v(m_qa)*v(vcc,gnd)\nSqa o_qa qa m_en 0 hc_sw\nAU7 sr0 d_srclk NULL x1 sr1 nsr1 hc_dff\nAU8 sr1 d_rclk NULL NULL st1 nst1 hc_dff\nAqb [st1] [m_qb] hc_out\nBqb o_qb gnd V = v(m_qb)*v(vcc,gnd)\nSqb o_qb qb m_en 0 hc_sw\nAU9 sr1 d_srclk NULL x1 sr2 nsr2 hc_dff\nAU10 sr2 d_rclk NULL NULL st2 nst2 hc_dff\nAqc [st2] [m_qc] hc_out\nBqc o_qc gnd V = v(m_qc)*v(vcc,gnd)\nSqc o_qc qc m_en 0 hc_sw\nAU11 sr2 d_srclk NULL x1 sr3 nsr3 hc_dff\nAU12 sr3 d_rclk NULL NULL st3 nst3 hc_dff\nAqd [st3] [m_qd] hc_out\nBqd o_qd gnd V = v(m_qd)*v(vcc,gnd)\nSqd o_qd qd m_en 0 hc_sw\nAU13 sr3 d_srclk NULL x1 sr4 nsr4 hc_dff\nAU14 sr4 d_rclk NULL NULL st4 nst4 hc_dff\nAqe [st4] [m_qe] hc_out\nBqe o_qe gnd V = v(m_qe)*v(vcc,gnd)\nSqe o_qe qe m_en 0 hc_sw\nAU15 sr4 d_srclk NULL x1 sr5 nsr5 hc_dff\nAU16 sr5 d_rclk NULL NULL st5 nst5 hc_dff\nAqf [st5] [m_qf] hc_out\nBqf o_qf gnd V = v(m_qf)*v(vcc,gnd)\nSqf o_qf qf m_en 0 hc_sw\nAU17 sr5 d_srclk NULL x1 sr6 nsr6 hc_dff\nAU18 sr6 d_rclk NULL NULL st6 nst6 hc_dff\nAqg [st6] [m_qg] hc_out\nBqg o_qg gnd V = v(m_qg)*v(vcc,gnd)\nSqg o_qg qg m_en 0 hc_sw\nAU19 sr6 d_srclk NULL x1 sr7 nsr7 hc_dff\nAU20 sr7 d_rclk NULL NULL st7 nst7 hc_dff\nAqh [st7] [m_qh] hc_out\nBqh o_qh gnd V = v(m_qh)*v(vcc,gnd)\nSqh o_qh qh m_en 0 hc_sw\nAqhs [sr7] [m_qhs] hc_out\nBqhs o_qhs gnd V = v(m_qhs)*v(vcc,gnd)\nRqhs o_qhs qhs 50\nRq vcc gnd 1meg\n.model hc_dff d_dff(clk_delay=14n set_delay=14n reset_delay=14n)\n.model hc_fb dac_bridge(out_low=0 out_high=1 out_undef=0.5 t_rise=1n t_fall=1n)\n.model hc_in adc_bridge(in_low=0.5 in_high=0.5)\n.model hc_not d_inverter(rise_delay=1p fall_delay=1p)\n.model hc_out dac_bridge(out_low=0 out_high=1 out_undef=0.5 t_rise=4n t_fall=4n)\n.model hc_sw sw(vt=0.5 vh=0.1 ron=50 roff=1g)\n.ends HC595"
        }
      }
    },
