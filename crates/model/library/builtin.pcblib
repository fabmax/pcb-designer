              "unit": 2,
              "pin": "5ce10000-0000-4000-9000-063aa8efee8c"
            },
            {
              "pad": "5ce10000-0000-4000-9000-9bdbd4962ae1",
              "unit": 2,
              "pin": "5ce10000-0000-4000-9000-41ad0fc955fc"
            },
            {
              "pad": "5ce10000-0000-4000-9000-b78a3b14149b",
              "unit": 3,
              "pin": "5ce10000-0000-4000-9000-4c5ee33d5790"
            },
            {
              "pad": "5ce10000-0000-4000-9000-b68a3b1412e8",
              "unit": 3,
              "pin": "5ce10000-0000-4000-9000-4f5ee33d5ca9"
            },
            {
              "pad": "5ce10000-0000-4000-9000-b98a3b141801",
              "unit": 3,
              "pin": "5ce10000-0000-4000-9000-4e5ee33d5af6"
            },
            {
              "pad": "5ce10000-0000-4000-9000-b88a3b14164e",
              "unit": 4,
              "pin": "5ce10000-0000-4000-9000-8668ca7acb5a"
            }
          ]
        }
      ],
      "sim": {
        "device": {
          "type": "subckt",
          "text": "* HC02: 4 gates.\n* XSPICE digital: inputs switch at VCC/2, outputs follow VCC through 50 ohm, typical\n* 5 V delays. Supply current isn't modelled.\n.subckt HC02 a1 b1 y1 a2 b2 y2 a3 b3 y3 a4 b4 y4 vcc gnd\nCa1 a1 gnd 3.5p\nBa1 n_a1 0 V = v(a1,gnd)/max(v(vcc,gnd),1)\nAa1 [n_a1] [d_a1] hc_in\nCb1 b1 gnd 3.5p\nBb1 n_b1 0 V = v(b1,gnd)/max(v(vcc,gnd),1)\nAb1 [n_b1] [d_b1] hc_in\nAU1 [d_a1 d_b1] g1 hc_nor\nAy1 [g1] [m_y1] hc_out\nBy1 o_y1 gnd V = v(m_y1)*v(vcc,gnd)\nRy1 o_y1 y1 50\nCa2 a2 gnd 3.5p\nBa2 n_a2 0 V = v(a2,gnd)/max(v(vcc,gnd),1)\nAa2 [n_a2] [d_a2] hc_in\nCb2 b2 gnd 3.5p\nBb2 n_b2 0 V = v(b2,gnd)/max(v(vcc,gnd),1)\nAb2 [n_b2] [d_b2] hc_in\nAU2 [d_a2 d_b2] g2 hc_nor\nAy2 [g2] [m_y2] hc_out\nBy2 o_y2 gnd V = v(m_y2)*v(vcc,gnd)\nRy2 o_y2 y2 50\nCa3 a3 gnd 3.5p\nBa3 n_a3 0 V = v(a3,gnd)/max(v(vcc,gnd),1)\nAa3 [n_a3] [d_a3] hc_in\nCb3 b3 gnd 3.5p\nBb3 n_b3 0 V = v(b3,gnd)/max(v(vcc,gnd),1)\nAb3 [n_b3] [d_b3] hc_in\nAU3 [d_a3 d_b3] g3 hc_nor\nAy3 [g3] [m_y3] hc_out\nBy3 o_y3 gnd V = v(m_y3)*v(vcc,gnd)\nRy3 o_y3 y3 50\nCa4 a4 gnd 3.5p\nBa4 n_a4 0 V = v(a4,gnd)/max(v(vcc,gnd),1)\nAa4 [n_a4] [d_a4] hc_in\nCb4 b4 gnd 3.5p\nBb4 n_b4 0 V = v(b4,gnd)/max(v(vcc,gnd),1)\nAb4 [n_b4] [d_b4] hc_in\nAU4 [d_a4 d_b4] g4 hc_nor\nAy4 [g4] [m_y4] hc_out\nBy4 o_y4 gnd V = v(m_y4)*v(vcc,gnd)\nRy4 o_y4 y4 50\nRq vcc gnd 1meg\n.model hc_in adc_bridge(in_low=0.5 in_high=0.5)\n.model hc_nor d_nor(rise_delay=8n fall_delay=8n)\n.model hc_out dac_bridge(out_low=0 out_high=1 out_undef=0.5 t_rise=4n t_fall=4n)\n.ends HC02"
        }
      }
    },
