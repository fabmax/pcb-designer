      "sim": {
        "device": {
          "type": "subckt",
          "text": "* HC74: two D flip-flops, preset and clear active low.\n* XSPICE digital: inputs switch at VCC/2, outputs follow VCC through 50 ohm, typical\n* 5 V delays. Supply current isn't modelled.\n.subckt HC74 clr1 d1 clk1 pre1 q1 nq1 clr2 d2 clk2 pre2 q2 nq2 vcc gnd\nCclr1 clr1 gnd 3.5p\nBclr1 n_clr1 0 V = v(clr1,gnd)/max(v(vcc,gnd),1)\nAclr1 [n_clr1] [d_clr1] hc_in\nCd1 d1 gnd 3.5p\nBd1 n_d1 0 V = v(d1,gnd)/max(v(vcc,gnd),1)\nAd1 [n_d1] [d_d1] hc_in\nCclk1 clk1 gnd 3.5p\nBclk1 n_clk1 0 V = v(clk1,gnd)/max(v(vcc,gnd),1)\nAclk1 [n_clk1] [d_clk1] hc_in\nCpre1 pre1 gnd 3.5p\nBpre1 n_pre1 0 V = v(pre1,gnd)/max(v(vcc,gnd),1)\nApre1 [n_pre1] [d_pre1] hc_in\nAU2 d_pre1 x1 hc_not\nAU4 d_clr1 x3 hc_not\nAU5 d_d1 d_clk1 x1 x3 q1_ nq1_ hc_dff\nAq1 [q1_] [m_q1] hc_out\nBq1 o_q1 gnd V = v(m_q1)*v(vcc,gnd)\nRq1 o_q1 q1 50\nAnq1 [nq1_] [m_nq1] hc_out\nBnq1 o_nq1 gnd V = v(m_nq1)*v(vcc,gnd)\nRnq1 o_nq1 nq1 50\nCclr2 clr2 gnd 3.5p\nBclr2 n_clr2 0 V = v(clr2,gnd)/max(v(vcc,gnd),1)\nAclr2 [n_clr2] [d_clr2] hc_in\nCd2 d2 gnd 3.5p\nBd2 n_d2 0 V = v(d2,gnd)/max(v(vcc,gnd),1)\nAd2 [n_d2] [d_d2] hc_in\nCclk2 clk2 gnd 3.5p\nBclk2 n_clk2 0 V = v(clk2,gnd)/max(v(vcc,gnd),1)\nAclk2 [n_clk2] [d_clk2] hc_in\nCpre2 pre2 gnd 3.5p\nBpre2 n_pre2 0 V = v(pre2,gnd)/max(v(vcc,gnd),1)\nApre2 [n_pre2] [d_pre2] hc_in\nAU7 d_pre2 x6 hc_not\nAU9 d_clr2 x8 hc_not\nAU10 d_d2 d_clk2 x6 x8 q2_ nq2_ hc_dff\nAq2 [q2_] [m_q2] hc_out\nBq2 o_q2 gnd V = v(m_q2)*v(vcc,gnd)\nRq2 o_q2 q2 50\nAnq2 [nq2_] [m_nq2] hc_out\nBnq2 o_nq2 gnd V = v(m_nq2)*v(vcc,gnd)\nRnq2 o_nq2 nq2 50\nRq vcc gnd 1meg\n.model hc_dff d_dff(clk_delay=14n set_delay=14n reset_delay=14n)\n.model hc_in adc_bridge(in_low=0.5 in_high=0.5)\n.model hc_not d_inverter(rise_delay=1p fall_delay=1p)\n.model hc_out dac_bridge(out_low=0 out_high=1 out_undef=0.5 t_rise=4n t_fall=4n)\n.ends HC74"
        }
      }
    },
