          ]
        },
        {
          "id": "8c884dd6-6db1-42ee-a36a-fb2667e37ccf",
          "name": "SOT-23-5",
          "footprint": "5ce10000-0000-4000-9000-96f4f56198c4",
          "connections": [
            {
              "pad": "5ce10000-0000-4000-9000-cccdac0dda11",
              "unit": 0,
              "pin": "4d15254c-4976-4852-906f-5a30cbac9a12"
            },
            {
              "pad": "5ce10000-0000-4000-9000-cbcdac0dd85e",
              "unit": 0,
              "pin": "f49a07c2-be12-4cde-9fd2-edbb651d3317"
            },
            {
              "pad": "5ce10000-0000-4000-9000-cacdac0dd6ab",
              "unit": 0,
              "pin": "78d6c059-d2e3-4b8e-a8cd-d1c19f4e667e"
            },
            {
              "pad": "5ce10000-0000-4000-9000-c9cdac0dd4f8",
              "unit": 0,
              "pin": "a0804792-01ea-4064-be8c-c1efb223b7d2"
            },
            {
              "pad": "5ce10000-0000-4000-9000-d0cdac0de0dd",
              "unit": 0,
              "pin": "0d68f4de-da98-46cc-820c-4c0c6c015656"
            }
          ]
        }
      ],
      "sim": {
        "device": {
          "type": "subckt",
          "text": "* Generic op amp: open-loop gain aol, one pole at gbw/aol, slew rate sr (V/s),\n* output within vhi of V+ and vlo of V-, quiescent current iq.\n.subckt OPAMP inp inn out vp vn params: aol=1e5 gbw=3meg sr=1.5meg vhi=0.1 vlo=0.1 iq=0.5m\nRin inp inn 10meg\n.param imax={sr*1m/(6.2831853*gbw)}\nBg 0 int I = imax * tanh(v(inp,inn) * 1m / imax)\nRp int 0 {aol/1m}\nCp int 0 {1m/(6.2831853*gbw)}\nDhi int vp DCLAMP\nDlo vn int DCLAMP\nBo o 0 V = min(max(v(int), v(vn)+vlo), v(vp)-vhi)\nRo o out 50\nIq vp vn {iq}\n.model DCLAMP D(IS=1e-12)\n.ends OPAMP"
        }
      }
    },
