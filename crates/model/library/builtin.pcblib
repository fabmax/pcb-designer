        }
      ],
      "sim": {
        "device": {
          "type": "subckt",
          "text": "* HC04: 6 gates.\n* XSPICE digital: inputs switch at VCC/2, outputs follow VCC through 50 ohm, typical\n* 5 V delays. Supply current isn't modelled.\n.subckt HC04 a1 y1 a2 y2 a3 y3 a4 y4 a5 y5 a6 y6 vcc gnd\nCa1 a1 gnd 3.5p\nBa1 n_a1 0 V = v(a1,gnd)/max(v(vcc,gnd),1)\nAa1 [n_a1] [d_a1] hc_in\nAU1 d_a1 g1 hc_inv\nAy1 [g1] [m_y1] hc_out\nBy1 o_y1 gnd V = v(m_y1)*v(vcc,gnd)\nRy1 o_y1 y1 50\nCa2 a2 gnd 3.5p\nBa2 n_a2 0 V = v(a2,gnd)/max(v(vcc,gnd),1)\nAa2 [n_a2] [d_a2] hc_in\nAU2 d_a2 g2 hc_inv\nAy2 [g2] [m_y2] hc_out\nBy2 o_y2 gnd V = v(m_y2)*v(vcc,gnd)\nRy2 o_y2 y2 50\nCa3 a3 gnd 3.5p\nBa3 n_a3 0 V = v(a3,gnd)/max(v(vcc,gnd),1)\nAa3 [n_a3] [d_a3] hc_in\nAU3 d_a3 g3 hc_inv\nAy3 [g3] [m_y3] hc_out\nBy3 o_y3 gnd V = v(m_y3)*v(vcc,gnd)\nRy3 o_y3 y3 50\nCa4 a4 gnd 3.5p\nBa4 n_a4 0 V = v(a4,gnd)/max(v(vcc,gnd),1)\nAa4 [n_a4] [d_a4] hc_in\nAU4 d_a4 g4 hc_inv\nAy4 [g4] [m_y4] hc_out\nBy4 o_y4 gnd V = v(m_y4)*v(vcc,gnd)\nRy4 o_y4 y4 50\nCa5 a5 gnd 3.5p\nBa5 n_a5 0 V = v(a5,gnd)/max(v(vcc,gnd),1)\nAa5 [n_a5] [d_a5] hc_in\nAU5 d_a5 g5 hc_inv\nAy5 [g5] [m_y5] hc_out\nBy5 o_y5 gnd V = v(m_y5)*v(vcc,gnd)\nRy5 o_y5 y5 50\nCa6 a6 gnd 3.5p\nBa6 n_a6 0 V = v(a6,gnd)/max(v(vcc,gnd),1)\nAa6 [n_a6] [d_a6] hc_in\nAU6 d_a6 g6 hc_inv\nAy6 [g6] [m_y6] hc_out\nBy6 o_y6 gnd V = v(m_y6)*v(vcc,gnd)\nRy6 o_y6 y6 50\nRq vcc gnd 1meg\n.model hc_in adc_bridge(in_low=0.5 in_high=0.5)\n.model hc_inv d_inverter(rise_delay=7n fall_delay=7n)\n.model hc_out dac_bridge(out_low=0 out_high=1 out_undef=0.5 t_rise=4n t_fall=4n)\n.ends HC04"
        }
      }
    },
