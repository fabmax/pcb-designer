--- a/src/frontend/parser/numparse.c
+++ b/src/frontend/parser/numparse.c
@@ -162,8 +162,10 @@
                     val, p_cur);
         }
 
-        /* Test if the number can be represented as an intger */
-        return (double) (int) val == val;
+        /* Test if the number can be represented as an intger. Out of int's
